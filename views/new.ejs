<%- include('header') %>
    <h1>New Message</h1>


    <form method="post" action="/new" id="new-message">
        <label for="user"> User
            <input type="text" name="user" id="user">
        </label>
        <br>
        <label for="message">Text
            <textarea name="message" id="message"></textarea>
        </label>
        <br>

        <button type="submit">Submit</button>
    </form>

    <%- include('footer') %>